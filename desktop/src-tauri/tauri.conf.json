{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxly",
  "version": "0.1.0-alpha",
  "identifier": "com.skybridgem.voxly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voxly — Local Voice Workspace",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/meeting-asr-go",
      "binaries/voxly-sensevoice-wrapper"
    ],
    "resources": ["resources/sensevoice/*"],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
